# Copia este archivo a .env.local y rellena los valores del proyecto de Supabase.
# Solo van aquí valores PÚBLICOS: la clave de servicio de Supabase nunca se
# pone en variables VITE_ (acabaría en el navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Servicio de IA de texto (Edge Function `ai-generate`). SOLO EN EL SERVIDOR:
# se definen como secretos de la función (`supabase secrets set …`), nunca con
# prefijo VITE_ ni en el navegador. Aquí van solo los nombres. Detalle y
# ejemplos de formato en docs/ia-texto.md.
#
# Qué adaptador y qué modelo sirve cada tarea. Adaptadores: anthropic-vertex,
# anthropic, mistral, anthropic-bedrock. Sin estas variables no hay IA (no hay
# valores por defecto ni proveedor simulado).
AI_TEXT_PROVIDER=
AI_TEXT_MODEL=
# Opcional, por tarea (si no se definen, valen las dos de arriba):
AI_TEXT_POST_CAPTION_PROVIDER=
AI_TEXT_POST_CAPTION_MODEL=
AI_TEXT_PROFILE_PROPOSAL_PROVIDER=
AI_TEXT_PROFILE_PROPOSAL_MODEL=
AI_TEXT_BRAND_CHECK_PROVIDER=
AI_TEXT_BRAND_CHECK_MODEL=
# Tabla de precios (JSON): { "adaptador/modelo": { "unidad": micros por unidad } }
AI_PRICES=
# Opcional: tiempo máximo de la llamada al proveedor, en milisegundos.
AI_TIMEOUT_MS=
# Opcional: «true» acepta proveedores o ubicaciones que procesan fuera de la UE.
AI_ALLOW_NON_EU_PROCESSING=
# Opcional: origen permitido para CORS (por defecto, cualquiera).
AI_ALLOWED_ORIGIN=
# Adaptador anthropic-vertex (Claude en Google Cloud Vertex AI, multirregión UE):
AI_VERTEX_PROJECT_ID=
AI_VERTEX_LOCATION=
AI_VERTEX_SERVICE_ACCOUNT_JSON=
# Adaptador anthropic (API directa; no procesa en la UE):
ANTHROPIC_API_KEY=
# Adaptador mistral:
MISTRAL_API_KEY=
# Adaptador anthropic-bedrock (Claude en Amazon Bedrock, región UE):
AI_BEDROCK_REGION=
AI_BEDROCK_ACCESS_KEY_ID=
AI_BEDROCK_SECRET_ACCESS_KEY=
AI_BEDROCK_SESSION_TOKEN=
AI_BEDROCK_BEARER_TOKEN=

# ───────────── IA · imagen y vídeo generativos (SOLO servidor) ─────────────
# Estas variables NO llevan el prefijo VITE_: son secretos de las funciones del
# servidor (Supabase → Edge Functions → Secrets) y nunca deben llegar al
# navegador. Aquí solo van los nombres; los valores no se guardan en el repo.
# Un proveedor sin su clave no se carga, y el servicio dice qué variable falta.
# Qué modelos existen, su precio y si están activos se decide en la tabla
# `ai_media_models`, no aquí. Ver docs/06-ia-medios.md.
#
# Elección (opcional). Formato «proveedor:modelo», tal como figura en el registro.
# AI_MEDIA_IMAGE_MODEL=
# AI_MEDIA_VIDEO_MODEL=
# Por defecto solo se eligen solos los modelos que procesan en la UE. Con «true»
# se admiten también los demás (un modelo fijado arriba se usa siempre).
# AI_MEDIA_ALLOW_NON_EU=
# Dirección pública (https) de la función que recibe los webhooks. Sin ella,
# los trabajos asíncronos se resuelven solo por sondeo.
# AI_MEDIA_WEBHOOK_BASE_URL=
# Proveedores simulados, solo para pruebas. Nunca en un entorno con clientes.
# AI_MEDIA_SIMULATED=
#
# Imagen · Google (Gemini) por Vertex AI. Ubicación por defecto: eu (multirregión UE).
# GOOGLE_VERTEX_PROJECT_ID=
# GOOGLE_VERTEX_LOCATION=
# GOOGLE_VERTEX_SERVICE_ACCOUNT_JSON=
#
# Imagen · Black Forest Labs (FLUX.2). Host por defecto: https://api.eu.bfl.ai
# BFL_API_KEY=
# BFL_API_BASE_URL=
#
# Imagen · Ideogram
# IDEOGRAM_API_KEY=
#
# Vídeo · Higgsfield. Sin el secreto de webhooks funciona, pero solo por sondeo.
# HIGGSFIELD_API_KEY_ID=
# HIGGSFIELD_API_KEY_SECRET=
# HIGGSFIELD_WEBHOOK_SECRET=
#
# Vídeo · fal.ai
# FAL_KEY=
