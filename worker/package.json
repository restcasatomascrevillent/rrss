{
  "name": "rrss-worker",
  "private": true,
  "version": "0.1.0",
  "description": "Trabajador de medios: consume la cola de trabajos y ejecuta FFmpeg",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:local": "node scripts/run-supabase.ts local",
    "start:staging": "node scripts/run-supabase.ts staging",
    "job": "node src/cli.ts",
    "schemas": "node scripts/write-schemas.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:reel": "vitest run tests/reel-template.test.ts"
  },
  "dependencies": {
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "robots-parser": "3.0.1",
    "unpdf": "2.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
