{
  "schemaVersion": 1,
  "id": "corte-ritmico",
  "name": "Corte rítmico",
  "description": "Cortes secos y piezas cortas, con un zoom rápido en cada foto. Texto grande con contorno en el centro. Conserva algo del sonido de los clips.",
  "canvas": { "width": 1080, "height": 1920, "fps": 30 },
  "timing": { "photoSeconds": 1.5, "maxClipSeconds": 3, "maxTotalSeconds": 20 },
  "transition": { "type": "cut", "seconds": 0 },
  "photoMotion": { "type": "zoom-in", "amount": 0.12 },
  "text": {
    "font": "default",
    "sizeRatio": 0.085,
    "color": "#FFFFFF",
    "position": "center",
    "marginRatio": 0.2,
    "maxWidthRatio": 0.86,
    "lineHeight": 1.2,
    "box": null,
    "outline": { "color": "#000000", "widthRatio": 0.08 },
    "fadeSeconds": 0
  },
  "audio": { "musicVolume": 0.45, "clipVolume": 0.6, "fadeInSeconds": 0.2, "fadeOutSeconds": 0.6 },
  "export": { "crf": 21, "preset": "veryfast", "audioBitrateKbps": 128 }
}
