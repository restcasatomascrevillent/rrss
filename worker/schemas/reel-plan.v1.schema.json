{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "media": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "photo"
              },
              "path": {
                "type": "string",
                "minLength": 5,
                "maxLength": 600
              },
              "focalPoint": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "seconds": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 10
              },
              "blur": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "type",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "video"
              },
              "path": {
                "type": "string",
                "minLength": 5,
                "maxLength": 600
              },
              "focalPoint": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "startAt": {
                "default": 0,
                "type": "number",
                "minimum": 0
              },
              "seconds": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 30
              },
              "blur": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "type",
              "path"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "texts": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "position": {
            "type": "string",
            "enum": [
              "top",
              "center",
              "bottom"
            ]
          }
        },
        "required": [
          "text",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "startAt": {
          "default": 0,
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "fontPath": {
      "type": "string",
      "minLength": 5,
      "maxLength": 600,
      "pattern": "\\.(ttf|otf)$"
    }
  },
  "required": [
    "media"
  ],
  "additionalProperties": false
}
